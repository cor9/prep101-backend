{
  "version": 2,
  "outputDirectory": ".",
  "functions": {
    "api/**": {
      "maxDuration": 300,
      "memory": 1024,
      "includeFiles": "{services/**,config/**,models/**,middleware/**,routes/**,methodology/**,pdfservices-api-credentials.json,package.json,node_modules/@adobe/pdfservices-node-sdk/**}"
    }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "https://prep101.childactor101.com"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET, POST, PUT, DELETE, OPTIONS, PATCH"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "Content-Type, Authorization, X-Requested-With, Accept, Origin"
        },
        {
          "key": "Access-Control-Max-Age",
          "value": "86400"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/app/stripe/success",
      "destination": "https://prep101.childactor101.com/app/stripe/success",
      "permanent": false
    },
    {
      "source": "/payment-success",
      "destination": "https://prep101.childactor101.com/payment-success",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/simple-backend-rag.js"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/finalize-guides",
      "schedule": "*/15 * * * *"
    }
  ]
}
